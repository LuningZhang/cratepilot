# If your local PostgreSQL uses peer auth, you can use: postgresql://localhost:5432/cratepilot
DB_DSN=postgresql://<db_user>:<db_password>@localhost:5432/cratepilot
DB_NAME=cratepilot
DB_ADMIN_DSN=postgresql://<db_user>:<db_password>@localhost:5432/postgres
ROOT_FOLDER=/Users/yourname/Music/DJ

# Optional: only needed for tests/integration/test_songs_crud.py
DB_HOST=localhost
DB_PORT=5432
DB_USER=<db_user>
DB_PASSWORD=<db_password>
